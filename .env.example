# Modelo de variáveis de ambiente. Copie para .env (que NÃO vai para o git) e preencha.
# Nenhum valor real aqui. Segredos de produção vão para os secrets do ambiente, nunca para o repositório.

# Banco (Postgres 16 local)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# API
API_PORT=8000
APP_ENV=
# Obrigatórios (32+ caracteres, aleatórios e DIFERENTES entre si); a API não sobe sem eles, salvo APP_ENV=teste ou ci.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SEGREDO_SESSAO=
SEGREDO_ID=

# Ingestor (usado a partir da Onda 2; deixe vazio até lá)
INGESTOR_USUARIO_SERVICO=
INGESTOR_SENHA_SERVICO=
